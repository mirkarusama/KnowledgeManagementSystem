# Copy to .env  (cp .env.example .env). Every setting is explained in kms/config.py.

# Which model setup the gateway uses:
#   config.demo.yaml    no downloads, copy-paste "answers"  (start here)
#   config.ollama.yaml  real small AI models via Ollama on your Mac
#   config.openai.yaml  OpenAI's cloud models (needs OPENAI_API_KEY below; sends text to OpenAI)
LITELLM_CONFIG=config.demo.yaml
# Your OpenAI key, only for config.openai.yaml. Never commit .env or paste the key in chat.
OPENAI_API_KEY=
# For Qwen3 models: switches off their long "thinking" output
KMS_PROMPT_SUFFIX=
# Ask the router model when keyword rules are unsure (slower on a laptop)
KMS_USE_LLM_ROUTER=false

KMS_LLM_BASE_URL=http://litellm:4000/v1
KMS_LLM_API_KEY=sk-kms-dev
KMS_EMBED_DIM=1024

KMS_QDRANT_URL=http://qdrant:6333
KMS_POSTGRES_DSN=postgresql://kms:kms@postgres:5432/kms
KMS_VALKEY_URL=redis://valkey:6379/0
KMS_OPA_URL=http://opa:8181

KMS_OIDC_ISSUER=http://localhost:8080/realms/kms
KMS_OIDC_INTERNAL_URL=http://keycloak:8080/realms/kms
KMS_MCP_CLIENT_SECRET=kms-mcp-secret
KMS_MCP_ATLASSIAN_URL=http://mcp-atlassian:8000/mcp

# Pretend Atlassian (default). For your real site see SETUP.md, "Connecting real Confluence and Jira".
KMS_CONFLUENCE_URL=http://mock-atlassian:9000
KMS_JIRA_URL=http://mock-atlassian:9000
# Links shown in answers (what your browser can open)
KMS_CONFLUENCE_PUBLIC_URL=http://localhost:9000
KMS_JIRA_PUBLIC_URL=http://localhost:9000
KMS_ATLASSIAN_DEPLOYMENT=datacenter
KMS_ATLASSIAN_SERVICE_USER=
KMS_ATLASSIAN_SERVICE_TOKEN=svc-dev-token
KMS_CONFIRM_MODE=exchange
KMS_CONFLUENCE_SPACES=
KMS_JIRA_PROJECTS=

# Optional extras (off on a laptop)
KMS_RERANK_URL=
KMS_USE_DOCLING=false
KMS_LANGFUSE_HOST=
KMS_LANGFUSE_PUBLIC_KEY=
KMS_LANGFUSE_SECRET_KEY=
